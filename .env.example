# DeepSeek API (https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-pro

# Source books and generated EPUB output
BOOKS_DIR=./books
RESULTS_DIR=./results

# Translation runtime
TRANSLATION_CONCURRENCY=1
TRANSLATION_RETRIES=3
TRANSLATION_TIMEOUT=300s
MAX_CHUNK_CHARS=7000
MAX_PAGES=0
OVERWRITE=false

# Python interpreter (change if python3 is not in PATH)
PYTHON_BIN=python3

# Path to PDF extractor script
PARSER_SCRIPT=parser/extract.py
